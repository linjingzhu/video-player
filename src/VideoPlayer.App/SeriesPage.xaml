<UserControl x:Class="VideoPlayer.App.SeriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VideoPlayer.App"
             Background="#050505"
             Foreground="#FFFFFF"
             FontSize="12"
             FontWeight="Regular"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <!--
    Skin Pack C token lock. Type 20/600, 12/400, 11/400. Same density as A.
    Selection #0E0E0E + hairline. Episode=E03, title=stem.
    Keep C header Back. No mock captions as chrome.
  -->
  <UserControl.Resources>
    <local:SkinCProgressBrushConverter x:Key="SkinCProgressBrush"/>
    <SolidColorBrush x:Key="SkinC.Bg" Color="#050505"/>
    <SolidColorBrush x:Key="SkinC.Panel" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="SkinC.Line" Color="#222222" Opacity="0.4"/>
    <SolidColorBrush x:Key="SkinC.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SkinC.Muted" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="SkinC.Accent" Color="#FFFFFF"/>
    <Geometry x:Key="SkinC.FolderIcon">M3.2,6.4 H8.1 L9.7,8.2 H20.8 V17.2 H3.2 Z</Geometry>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="SkinC.Type20" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SkinC.Type11" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Muted}"/>
    </Style>

    <Style x:Key="SkinC.CellText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
    </Style>

    <Style x:Key="SkinCGhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SkinCOutlineCapsule" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource SkinC.Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Background" Value="{StaticResource SkinC.Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeView">
            <Border Background="{TemplateBinding Background}" BorderThickness="0">
              <ScrollViewer Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Padding="{TemplateBinding Padding}">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="{TemplateBinding Padding}"
                      Margin="4,2">
                <ContentPresenter ContentSource="Header"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0E0E0E"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SkinC.Line}"/>
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SkinC.Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="SeparatorVisibility" Value="Collapsed"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SkinC.Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
  </UserControl.Resources>

  <Border Background="{StaticResource SkinC.Panel}"
          BorderBrush="{StaticResource SkinC.Line}"
          BorderThickness="1"
          CornerRadius="4"
          Margin="16">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="16,12,16,10" MinHeight="36">
        <Button x:Name="BackButton"
                Style="{StaticResource SkinCGhostButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="←"
                Click="Back_Click"
                ToolTip="뒤로"/>
        <TextBlock x:Name="TitleText"
                   Style="{StaticResource SkinC.Type20}"
                   Text="시리즈"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <Button x:Name="OpenFolderButton"
                Style="{StaticResource SkinCOutlineCapsule}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OpenFolder_Click">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource SkinC.FolderIcon}"
                  Stroke="{StaticResource SkinC.Text}"
                  StrokeThickness="1.15"
                  Fill="Transparent"
                  Width="15"
                  Height="12"
                  Stretch="Uniform"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"/>
            <TextBlock Text="폴더 열기" FontSize="12" FontWeight="Regular" Foreground="{StaticResource SkinC.Text}"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border DockPanel.Dock="Bottom"
              BorderBrush="{StaticResource SkinC.Line}"
              BorderThickness="0,1,0,0"
              Padding="16,10">
        <Grid>
          <TextBlock x:Name="FooterLeftText" Style="{StaticResource SkinC.Type11}"/>
          <TextBlock x:Name="FooterRightText"
                     Style="{StaticResource SkinC.Type11}"
                     Text="정렬 회차 고정"
                     HorizontalAlignment="Right"/>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TreeView x:Name="SeriesTree"
                  Grid.Column="0"
                  SelectedItemChanged="SeriesTree_Selected">
          <TreeView.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
          </TreeView.Resources>
        </TreeView>

        <Border Grid.Column="1" Width="1" Background="{StaticResource SkinC.Line}"/>

        <DataGrid x:Name="SeriesGrid"
                  Grid.Column="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource SkinC.Line}"
                  VerticalGridLinesBrush="Transparent"
                  BorderThickness="0"
                  Background="{StaticResource SkinC.Panel}"
                  Foreground="{StaticResource SkinC.Text}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="12"
                  FontWeight="Regular"
                  MouseDoubleClick="SeriesGrid_Activate">
          <DataGrid.Columns>
            <DataGridTextColumn Header="회차" Binding="{Binding Episode}" Width="80" CanUserSort="False"
                                ElementStyle="{StaticResource SkinC.CellText}"/>
            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" CanUserSort="False"
                                ElementStyle="{StaticResource SkinC.CellText}"/>
            <DataGridTextColumn Header="진행" Binding="{Binding Progress}" Width="90" CanUserSort="False">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SkinC.CellText}">
                  <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource SkinCProgressBrush}}"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
