<UserControl x:Class="VideoPlayer.App.SeriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF141414">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="12,10,12,8" MinHeight="36">
      <Button x:Name="BackButton" HorizontalAlignment="Left" VerticalAlignment="Center"
              Content="←" Padding="12,4" Click="Back_Click" ToolTip="뒤로"/>
      <TextBlock x:Name="TitleText" Text="시리즈" FontSize="20" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="OpenFolderButton" HorizontalAlignment="Right" VerticalAlignment="Center"
              Click="OpenFolder_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="📁" Margin="0,0,6,0"/>
          <TextBlock Text="폴더 열기"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid DockPanel.Dock="Bottom" Margin="16,8,16,10">
      <TextBlock x:Name="FooterLeftText" Foreground="#FF9A9A9A"/>
      <TextBlock x:Name="FooterRightText" Text="정렬 회차 고정" HorizontalAlignment="Right" Foreground="#FF9A9A9A"/>
    </Grid>

    <Grid Margin="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FF1C1C1C" BorderBrush="#FF3A3A3A" BorderThickness="1,1,0,1">
        <TreeView x:Name="SeriesTree" Background="#FF1C1C1C" Foreground="#FFF2F2F2" BorderThickness="0"
                  SelectedItemChanged="SeriesTree_Selected">
          <TreeView.Resources>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="#FFF2F2F2"/>
              <Setter Property="Padding" Value="4,3"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TreeView.Resources>
        </TreeView>
      </Border>

      <Border Grid.Column="1" Background="#FF1C1C1C" BorderBrush="#FF3A3A3A" BorderThickness="1">
        <DataGrid x:Name="SeriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderThickness="0"
                  Background="#FF1C1C1C" Foreground="#FFF2F2F2"
                  RowBackground="#FF1C1C1C" AlternatingRowBackground="#FF1C1C1C"
                  HorizontalGridLinesBrush="#FF2A2A2A"
                  MouseDoubleClick="SeriesGrid_Activate">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#FF1A1A1A"/>
              <Setter Property="Foreground" Value="#FFF2F2F2"/>
              <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
              <Setter Property="Padding" Value="10,6"/>
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="회차" Binding="{Binding Episode}" Width="80" CanUserSort="False"/>
            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" CanUserSort="False"/>
            <DataGridTextColumn Header="진행" Binding="{Binding Progress}" Width="90" CanUserSort="False"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
