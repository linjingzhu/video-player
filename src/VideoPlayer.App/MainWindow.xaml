<Window x:Class="VideoPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoPlayer.App"
        Title="영상 플레이어"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#FF0B0B0D"
        Foreground="#FFF5F5F7"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="12"
        FontWeight="Regular"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseWheel="OnPreviewMouseWheel"
        Closing="OnClosing">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#14FFFFFF" Foreground="#FFF5F5F7"
          FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Regular">
      <MenuItem Header="파일" Background="#14FFFFFF" Foreground="#FFF5F5F7" FontSize="12" FontWeight="Regular">
        <MenuItem Header="열기..." Click="OpenFile_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="URL 열기" Click="OpenUrl_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="폴더 열기" Click="OpenFolder_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <Separator/>
        <MenuItem Header="종료" Click="Exit_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
      </MenuItem>
      <TextBlock Text="|" Margin="4,0" VerticalAlignment="Center" Style="{StaticResource SkinAMetaText}" IsHitTestVisible="False"/>
      <MenuItem Header="보기" Background="#14FFFFFF" Foreground="#FFF5F5F7" FontSize="12" FontWeight="Regular">
        <MenuItem x:Name="ShowSeriesItem" Header="시리즈" Click="ShowSeries_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="사이드바" Click="ToggleSidebar_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="자막" Click="SubtitlesMenu_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="여기까지 스킵" Click="SkipToHere_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem x:Name="SkipAutoItem" Header="건너뛰기 자동" IsCheckable="True" IsChecked="False"
                  Click="SkipAuto_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem Header="전체화면" Click="Fullscreen_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem x:Name="AutoNextItem" Header="다음 화 자동 재생" IsCheckable="True" IsChecked="True"
                  Click="AutoNext_Click" Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <Separator/>
        <MenuItem x:Name="CaptureMenuItem" Header="캡처" InputGestureText="Ctrl+Shift+C" Click="CaptureMenu_Click"
                  Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
        <MenuItem x:Name="ClipSaveMenuItem" Header="구간 저장" Click="ClipSaveMenu_Click"
                  Background="#FF141418" Foreground="#FFF5F5F7"
                  FontSize="12" FontWeight="Regular"/>
      </MenuItem>
    </Menu>

    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="Transparent"
            BorderBrush="#332C2C2E" BorderThickness="0,1,0,0" Padding="12,4" Height="28"
            ClipToBounds="True" Visibility="Collapsed">
      <Grid>
        <Border Background="#14FFFFFF" IsHitTestVisible="False" Effect="{StaticResource SkinAChromeBlur}"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource SkinAMetaText}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border x:Name="TransportBar" DockPanel.Dock="Bottom" Background="Transparent"
            BorderBrush="#332C2C2E" BorderThickness="0,1,0,0" Height="40" Padding="12,0"
            ClipToBounds="True">
      <Grid>
        <Border Background="#14FFFFFF" IsHitTestVisible="False" Effect="{StaticResource SkinAChromeBlur}"/>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PrevButton" Click="Prev_Click" ToolTip="이전 화" Style="{StaticResource IconButton}">
            <Path Stroke="#FFF5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Data="M 5,5 V 19 M 19,5 L 7,12 L 19,19"/>
          </Button>
          <Button Content="-10초" Click="SkipBack_Click" Style="{StaticResource SkinATextButton}"/>
          <Button x:Name="PlayButton" Click="PlayPause_Click" Style="{StaticResource SkinAPlayButton}" ToolTip="재생">
            <Grid Width="14" Height="14">
              <Path x:Name="PlayIcon" Fill="#FF0B0B0D" Stretch="Uniform" Data="M 3,1 L 13,7 L 3,13 Z"/>
              <Path x:Name="PauseIcon" Fill="#FF0B0B0D" Stretch="Uniform" Visibility="Collapsed"
                    Data="M 2,1 H 5.5 V 13 H 2 Z M 8.5,1 H 12 V 13 H 8.5 Z"/>
            </Grid>
          </Button>
          <Button Content="+10초" Click="SkipForward_Click" Style="{StaticResource SkinATextButton}"/>
          <Button x:Name="NextButton" Click="Next_Click" ToolTip="다음 화" Style="{StaticResource IconButton}">
            <Path Stroke="#FFF5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Data="M 19,5 V 19 M 5,5 L 17,12 L 5,19"/>
          </Button>
        </StackPanel>
        <Grid x:Name="SeekHost" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
              SizeChanged="SeekHost_SizeChanged">
          <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0"
                  VerticalAlignment="Center" Style="{StaticResource ChromeSlider}"
                  PreviewMouseLeftButtonUp="SeekSlider_Committed"/>
          <Canvas x:Name="MarkCanvas" IsHitTestVisible="False" Height="16" VerticalAlignment="Center">
            <Ellipse x:Name="InTick" Width="8" Height="8" Fill="#FFFFFFFF" Visibility="Collapsed"/>
            <Ellipse x:Name="OutTick" Width="8" Height="8" Fill="#FFFFFFFF" Visibility="Collapsed"/>
          </Canvas>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Path Stroke="#FFF5F5F7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"
                Data="M 2,9 H 6 L 11,5 V 19 L 6,15 H 2 Z M 14,9 C 16,10 16,14 14,15"/>
          <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="1"
                  VerticalAlignment="Center" Style="{StaticResource ChromeSlider}"
                  ValueChanged="Volume_Changed"/>
          <Button x:Name="SpeedButton" Content="1.0x" Click="CycleSpeed_Click" Style="{StaticResource SkinATextButton}"/>
          <Button x:Name="CaptionsButton" Content="CC" Click="Captions_Click" Style="{StaticResource SkinATextButton}"/>
          <Button Click="Fullscreen_Click" ToolTip="전체화면" Style="{StaticResource IconButton}">
            <Path Stroke="#FFF5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 5,9 V 5 H 9 M 15,5 H 19 V 9 M 19,15 V 19 H 15 M 9,19 H 5 V 15"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarRailColumn" Width="28"/>
        <ColumnDefinition x:Name="SidebarContentColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarRail" Grid.Column="0" Background="Transparent" BorderBrush="#332C2C2E" BorderThickness="0,0,1,0"
              ClipToBounds="True">
        <Grid>
          <Border Background="#14FFFFFF" IsHitTestVisible="False" Effect="{StaticResource SkinAChromeBlur}"/>
          <Button x:Name="SidebarToggle" Click="ToggleSidebar_Click" Style="{StaticResource RailButton}"
                  ToolTip="사이드바" VerticalAlignment="Top" Margin="0,4,0,0">
            <Path Stroke="#FFF5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20"/>
          </Button>
        </Grid>
      </Border>

      <Border x:Name="SidebarPanel" Grid.Column="1" Background="#FF141418" BorderBrush="#332C2C2E" BorderThickness="0,0,1,0" Visibility="Collapsed">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="최근 / 시리즈" Style="{StaticResource SkinATitleText}"
                     Margin="12,10,12,6"/>
          <ListBox x:Name="SidebarList" MouseDoubleClick="Sidebar_Activate" MouseLeftButtonUp="Sidebar_Activate"
                   Background="#FF141418" Foreground="#FFF5F5F7" BorderThickness="0"
                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Regular"/>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid x:Name="VideoPage">
          <Border x:Name="VideoHostBorder" Background="#FF000000" Margin="0" Padding="0" BorderThickness="0"
                  MouseLeftButtonDown="Video_Click">
            <Grid>
              <WindowsFormsHost x:Name="PlayerHost"/>
              <TextBlock x:Name="OverlayTime" Text="00:00:00 / 00:00:00"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="16,0,0,12" Style="{StaticResource SkinAMetaText}"
                         IsHitTestVisible="False"/>
              <TextBlock x:Name="OverlaySecondarySubtitle" Text="" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="16,28,16,0" FontSize="18" TextAlignment="Center"
                         Effect="{StaticResource OverlayShadow}" IsHitTestVisible="False"/>
              <TextBlock x:Name="OverlaySubtitle" Text="" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="16,0,16,40" FontSize="20" TextAlignment="Center"
                         Effect="{StaticResource OverlayShadow}" IsHitTestVisible="False"/>
              <StackPanel x:Name="VideoOverlayStack" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
                <Border x:Name="SkipCapsule" HorizontalAlignment="Right" Margin="0,0,0,10"
                        Padding="16,8" CornerRadius="999"
                        Background="{StaticResource PackPanelBrush}"
                        BorderBrush="{StaticResource PackHairlineBrush}" BorderThickness="1"
                        PreviewMouseLeftButtonDown="OverlayChrome_MouseDown"
                        Visibility="Collapsed">
                  <StackPanel>
                    <Button x:Name="SkipCapsuleButton" Content="인트로 건너뛰기"
                            Click="SkipCapsule_Click" Style="{StaticResource SkipCapsuleButton}"/>
                    <Button x:Name="SkipCancelButton" Content="취소 (3)"
                            Click="SkipCancel_Click" Style="{StaticResource SkipCapsuleButton}"
                            FontSize="11" Foreground="{StaticResource PackMutedBrush}"
                            Margin="0,2,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="NextCtaPanel" HorizontalAlignment="Right" Visibility="Collapsed">
                  <Button x:Name="NextCtaButton" Content="다음 화 >" Click="Next_Click" Style="{StaticResource NextCtaButton}"/>
                  <Button x:Name="CancelAutoNextButton" Content="취소" Click="CancelAutoNext_Click" Margin="0,6,0,0"
                          Style="{StaticResource SkinATextButton}" Visibility="Collapsed"/>
                </StackPanel>
              </StackPanel>
              <Border x:Name="CaptureBanner" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,16,0,0" Padding="14,8" CornerRadius="10"
                      Background="#E6141418" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="CaptureBannerText" FontSize="12" Foreground="#FFF5F5F7"
                           FontFamily="{StaticResource CaptureFont}"/>
              </Border>
              <Border x:Name="CaptureSheet" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,16,16,0" Padding="18,16" CornerRadius="12"
                      Background="{StaticResource CaptureSheetBrush}"
                      Effect="{StaticResource CaptureSheetShadow}"
                      Visibility="Collapsed">
                <DockPanel>
                  <TextBlock x:Name="CaptureSheetTitle" DockPanel.Dock="Top" Text="캡처"
                             FontFamily="{StaticResource CaptureFont}" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource CaptureTextBrush}" Margin="0,0,0,14"/>
                  <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="현재 위치부터 · 캡처 중 일시정지"
                               FontFamily="{StaticResource CaptureFont}" FontSize="11"
                               Foreground="{StaticResource CaptureMutedBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="취소" Click="CaptureCancel_Click" Style="{StaticResource CaptureSheetButton}" Margin="0,0,8,0"/>
                      <Button Content="시작" Click="CaptureStart_Click" Style="{StaticResource CaptureStartButton}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="장수" VerticalAlignment="Center" Foreground="{StaticResource CaptureTextBrush}" FontFamily="{StaticResource CaptureFont}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Click="CaptureCountMinus_Click" Style="{StaticResource CaptureStepperButton}"/>
                        <TextBlock x:Name="CaptureCountText" Text="1" Width="40" TextAlignment="Center"
                                   VerticalAlignment="Center" FontFamily="{StaticResource CaptureFont}" FontSize="12"/>
                        <Button Content="+" Click="CaptureCountPlus_Click" Style="{StaticResource CaptureStepperButton}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="1-999" VerticalAlignment="Center"
                                 Foreground="{StaticResource CaptureMutedBrush}" FontSize="11"
                                 FontFamily="{StaticResource CaptureFont}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="간격" VerticalAlignment="Center" Foreground="{StaticResource CaptureTextBrush}" FontFamily="{StaticResource CaptureFont}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Click="CaptureIntervalMinus_Click" Style="{StaticResource CaptureStepperButton}"/>
                        <TextBlock x:Name="CaptureIntervalText" Text="1프레임" MinWidth="64" TextAlignment="Center"
                                   VerticalAlignment="Center" FontFamily="{StaticResource CaptureFont}" FontSize="12"/>
                        <Button Content="+" Click="CaptureIntervalPlus_Click" Style="{StaticResource CaptureStepperButton}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="포맷" VerticalAlignment="Center" Foreground="{StaticResource CaptureTextBrush}" FontFamily="{StaticResource CaptureFont}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="FormatPng" Content="png" Tag="png" Click="CaptureFormat_Click" Style="{StaticResource CaptureFormatButton}"/>
                        <Button x:Name="FormatJpg" Content="jpg" Tag="jpg" Click="CaptureFormat_Click" Style="{StaticResource CaptureFormatButton}"/>
                        <Button x:Name="FormatWebp" Content="webp" Tag="webp" Click="CaptureFormat_Click" Style="{StaticResource CaptureFormatButton}"/>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="폴더" VerticalAlignment="Center" Foreground="{StaticResource CaptureTextBrush}" FontFamily="{StaticResource CaptureFont}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource CaptureTextBrush}"
                              StrokeThickness="1.4" Fill="Transparent" Margin="0,0,8,0"
                              Data="M 1,5 L 1,13 L 15,13 L 15,6 L 8,6 L 6.5,4 Z"/>
                        <TextBlock x:Name="CaptureFolderText" Text="Pictures" VerticalAlignment="Center"
                                   FontFamily="{StaticResource CaptureFont}" FontSize="12"
                                   Foreground="{StaticResource CaptureTextBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="2" Content="변경" Click="CaptureChangeFolder_Click" Style="{StaticResource CaptureSheetButton}"/>
                    </Grid>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border x:Name="SubtitleSheet" Width="320" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,16,16,16" Padding="16,14" CornerRadius="12"
                      Background="{StaticResource PackPanelBrush}"
                      Effect="{StaticResource PackSheetShadow}"
                      PreviewMouseLeftButtonDown="OverlayChrome_MouseDown"
                      Visibility="Collapsed">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="자막"
                             FontFamily="{StaticResource PackFont}" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource PackTextBrush}" Margin="0,0,0,12"/>
                  <TextBlock DockPanel.Dock="Bottom" Text="주 · 상단에 보조"
                             FontFamily="{StaticResource PackFont}" FontSize="11"
                             Foreground="{StaticResource PackMutedBrush}" Margin="0,10,0,0"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="보조 자막 (상단)" FontSize="11" Foreground="{StaticResource PackMutedBrush}"
                                 FontFamily="{StaticResource PackFont}" Margin="0,0,0,6"/>
                      <StackPanel x:Name="SecondarySubtitleRows"/>
                      <TextBlock Text="주 자막 (하단)" FontSize="11" Foreground="{StaticResource PackMutedBrush}"
                                 FontFamily="{StaticResource PackFont}" Margin="0,8,0,6"/>
                      <StackPanel x:Name="PrimarySubtitleRows"/>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <local:SeriesPage x:Name="SeriesPage" Visibility="Collapsed"
                          BackRequested="SeriesBack_Click"
                          OpenFolderRequested="OpenFolder_Click"
                          EpisodeActivated="SeriesPage_EpisodeActivated"/>
        <Border x:Name="ClipBanner" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" Padding="14,8" CornerRadius="10"
                Background="#E6141418" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="ClipBannerText" FontSize="12" Foreground="#FFF5F5F7"
                     FontFamily="{StaticResource ClipFont}"/>
        </Border>
        <Grid x:Name="ClipOverlay" Visibility="Collapsed" Background="#66000000"
              MouseLeftButtonDown="ClipOverlay_Click">
          <Border x:Name="ClipSheet" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Padding="20,18" CornerRadius="12"
                  Background="{StaticResource ClipSheetBrush}"
                  Effect="{StaticResource ClipSheetShadow}"
                  MouseLeftButtonDown="ClipSheet_EatClick">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="구간 저장"
                         FontFamily="{StaticResource ClipFont}" FontSize="20" FontWeight="SemiBold"
                         Foreground="{StaticResource ClipTextBrush}" Margin="0,0,0,14"/>
              <TextBlock x:Name="ClipPreviewName" DockPanel.Dock="Bottom"
                         FontFamily="{StaticResource ClipFont}" FontSize="11"
                         Foreground="{StaticResource ClipMutedBrush}"
                         TextWrapping="Wrap" Margin="0,14,0,0"/>
              <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="저장" Click="ClipSave_Click" Style="{StaticResource ClipSaveButton}"
                        x:Name="ClipSaveButton"/>
                <Button Grid.Column="2" Content="취소" Click="ClipCancel_Click" Style="{StaticResource ClipSheetButton}"/>
              </Grid>
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="시작" FontSize="11" Foreground="{StaticResource ClipMutedBrush}"
                               FontFamily="{StaticResource ClipFont}"/>
                    <TextBlock x:Name="ClipStartText" Text="00:00:00" FontSize="12"
                               Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="끝" FontSize="11" Foreground="{StaticResource ClipMutedBrush}"
                               FontFamily="{StaticResource ClipFont}"/>
                    <TextBlock x:Name="ClipEndText" Text="00:00:00" FontSize="12"
                               Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="길이" FontSize="11" Foreground="{StaticResource ClipMutedBrush}"
                               FontFamily="{StaticResource ClipFont}"/>
                    <TextBlock x:Name="ClipDurationText" Text="00:00:00" FontSize="12"
                               Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="형식" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ClipFormatCopy" Content="원본복사" Tag="copy" Click="ClipFormat_Click"
                            Style="{StaticResource ClipFormatButton}"/>
                    <Button x:Name="ClipFormatWebp" Content="webp" Tag="webp" Click="ClipFormat_Click"
                            Style="{StaticResource ClipFormatButton}"/>
                    <Button x:Name="ClipFormatGif" Content="gif" Tag="gif" Click="ClipFormat_Click"
                            Style="{StaticResource ClipFormatButton}"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10" x:Name="ClipFpsRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="fps" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="-" Click="ClipFpsMinus_Click" Style="{StaticResource ClipStepperButton}"
                            x:Name="ClipFpsMinus"/>
                    <TextBlock x:Name="ClipFpsText" Text="원본" Width="44" TextAlignment="Center"
                               VerticalAlignment="Center" FontFamily="{StaticResource ClipFont}" FontSize="12"
                               Foreground="{StaticResource ClipTextBrush}"/>
                    <Button Content="+" Click="ClipFpsPlus_Click" Style="{StaticResource ClipStepperButton}"
                            x:Name="ClipFpsPlus"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10" x:Name="ClipPingPongRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="핑퐁" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  <Button x:Name="ClipPingPongToggle" Click="ClipPingPong_Click"
                          HorizontalAlignment="Left" Style="{StaticResource ClipSheetButton}"
                          Padding="18,5" MinWidth="52"/>
                </Grid>
                <Grid x:Name="ClipPaletteRow" Margin="0,0,0,10" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="팔레트" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  <TextBlock Grid.Column="1" Text="256색" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipMutedBrush}" FontFamily="{StaticResource ClipFont}"/>
                </Grid>
                <TextBlock x:Name="ClipEncodingHint" Text="원본복사에서는 꺼짐"
                           FontSize="11" Foreground="{StaticResource ClipMutedBrush}"
                           FontFamily="{StaticResource ClipFont}" Margin="0,0,0,2"/>
                <TextBlock x:Name="ClipKeyframeNotice" Text="키프레임 단위로 저장됩니다."
                           FontSize="11" Foreground="{StaticResource ClipMutedBrush}"
                           FontFamily="{StaticResource ClipFont}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="폴더" VerticalAlignment="Center"
                             Foreground="{StaticResource ClipTextBrush}" FontFamily="{StaticResource ClipFont}"/>
                  <Border Grid.Column="1" Background="#FF1C1C20" BorderBrush="{StaticResource ClipBorderBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="ClipFolderText" Text="Videos\구간" VerticalAlignment="Center"
                               FontFamily="{StaticResource ClipFont}" FontSize="12"
                               Foreground="{StaticResource ClipTextBrush}"/>
                  </Border>
                  <Button Grid.Column="2" Content="변경" Click="ClipChangeFolder_Click"
                          Style="{StaticResource ClipSheetButton}"/>
                </Grid>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
