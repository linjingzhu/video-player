<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoPlayer.App</RootNamespace>
    <AssemblyName>Ieseo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Ieseo.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>이어서</AssemblyTitle>
    <Product>이어서</Product>
    <Description>Windows local series video player (libmpv / FFmpeg).</Description>
    <!-- WPF-first hybrid: PerMonitorV2 is declared in app.manifest so WPF
         picks it up at process start. WinForms is only used for OS dialogs.
         Calling Application.SetHighDpiMode would conflict (WFAC010) and is
         too late to change WPF chrome. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VideoPlayer.Core\VideoPlayer.Core.csproj" />
  </ItemGroup>
</Project>
